# 智岗罗盘 ETL 调度 crontab 示例（Linux）
#
# 部署：
#   crontab -e
#   :r scripts/cron/crontab.example
#
# 前置条件：
#   1. Redis 已启动（默认 redis://localhost:6379/1）
#   2. ARQ Worker 已运行：
#        cd /path/to/backend && nohup uv run arq app.workers.tasks.WorkerSettings > logs/worker.log 2>&1 &
#   3. PostgreSQL + Neo4j 已启动
#   4. 国际源需配置 HTTPS_PROXY 环境变量（Clash/V2Ray Rule 模式）
#
# 时区：所有时间为服务器本地时间（建议 Asia/Shanghai）
# 日志：每日独立日志文件 logs/etl_YYYYMMDD.log

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""
# 项目 backend 目录绝对路径（部署时替换）
BACKEND_DIR=/opt/zhigang-compass/backend
LOG_DIR=/opt/zhigang-compass/logs

# ── 国内 A 级招聘平台（每日 02:00）──
0 2 * * * cd $BACKEND_DIR && uv run python scripts/cron/crawl_spider.py boss 100 >> $LOG_DIR/crawl_boss_$(date +\%Y\%m\%d).log 2>&1
15 2 * * * cd $BACKEND_DIR && uv run python scripts/cron/crawl_spider.py zhilian 100 >> $LOG_DIR/crawl_zhilian_$(date +\%Y\%m\%d).log 2>&1

# ── 国际招聘平台（每日 04:00，UTC 0:00 对应北京时间 08:00，错峰至 04:00 减少白天负载）──
0 4 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py monster 50 >> $LOG_DIR/crawl_monster_$(date +\%Y\%m\%d).log 2>&1
20 4 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py indeed 50 >> $LOG_DIR/crawl_indeed_$(date +\%Y\%m\%d).log 2>&1
40 4 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py glassdoor 50 >> $LOG_DIR/crawl_glassdoor_$(date +\%Y\%m\%d).log 2>&1

# ── 脉脉夜间合规窗口（23:00 - 06:00，≤100 req/h）──
0 23 * * * cd $BACKEND_DIR && uv run python scripts/cron/crawl_spider.py maimai 30 >> $LOG_DIR/crawl_maimai_$(date +\%Y\%m\%d).log 2>&1

# ── 国际非招聘源（每日 UTC 0:00 = 北京时间 08:00）──
0 8 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py linkedin_public 50 >> $LOG_DIR/crawl_linkedin_$(date +\%Y\%m\%d).log 2>&1
15 8 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py github 50 >> $LOG_DIR/crawl_github_$(date +\%Y\%m\%d).log 2>&1
30 8 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py stackoverflow 50 >> $LOG_DIR/crawl_stackoverflow_$(date +\%Y\%m\%d).log 2>&1

# ── arXiv 论文（每日 UTC 3:00 = 北京时间 11:00）──
0 11 * * * cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py arxiv 50 >> $LOG_DIR/crawl_arxiv_$(date +\%Y\%m\%d).log 2>&1

# ── 课程平台每周日全量同步（UTC 2:00 = 北京时间 10:00）──
0 10 * * 0 cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py coursera 100 >> $LOG_DIR/crawl_coursera_$(date +\%Y\%m\%d).log 2>&1
30 10 * * 0 cd $BACKEND_DIR && HTTPS_PROXY=http://127.0.0.1:7890 uv run python scripts/cron/crawl_spider.py edx 100 >> $LOG_DIR/crawl_edx_$(date +\%Y\%m\%d).log 2>&1
0 11 * * 0 cd $BACKEND_DIR && uv run python scripts/cron/crawl_spider.py icourse163 100 >> $LOG_DIR/crawl_icourse163_$(date +\%Y\%m\%d).log 2>&1

# ── ETL 主管线（每日 05:00 触发编排，5:00 前完成 T+1 图谱更新）──
0 5 * * * cd $BACKEND_DIR && uv run python scripts/cron/etl_daily.py >> $LOG_DIR/etl_$(date +\%Y\%m\%d).log 2>&1

# ── 时效衰减每日凌晨 4:00 重算（设计文档 §4.7.5）──
# 由 run_etl_pipeline 内 validate_temporal 阶段覆盖，无需独立任务
