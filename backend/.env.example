# ==========================================
# 智岗罗盘 — 环境变量模板
# 复制为 .env 后填写实际值
# ==========================================

# ---------- 应用 ----------
APP_ENV=development
SECRET_KEY=change-me-in-production

# ---------- PostgreSQL ----------
POSTGRES_DSN=postgresql+asyncpg://zhigang:zhigang@localhost:5432/zhigang

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0


# ---------- JWT ----------
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 前端 ----------
FRONTEND_DIST_DIR=../frontend/dist

# ---------- 爬虫：CDP 浏览器（BOSS/Monster/Glassdoor/脉脉共用） ----------
# 通过 CDP 连接已登录的真实浏览器（隔离 profile 持久化登录态），无需 env cookie。
# 本地默认 http://127.0.0.1:9222；容器内浏览器部署时改为局域网地址，如
# BOSS_CDP_URL=http://192.168.1.10:9222
BOSS_CDP_URL=http://127.0.0.1:9222

# ---------- 爬虫：国际平台代理（可选） ----------
# 仅采集国际平台（Indeed/Monster/Glassdoor/LinkedIn）时需要
# 国内平台（BOSS/智联/脉脉）直连，不需要代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---------- 告警（设计文档 §4.4 异常阈值 webhook） ----------
# 爬虫失败 / 数据过期时推送的 webhook 地址（兼容飞书/钉钉/企业微信群机器人）。
# 未配置时告警仅记日志，不阻塞主流程。
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
