# ==========================================
# 智岗罗盘 .gitignore
# 多源异构驱动的岗位能力动态演化与人岗匹配系统
# ==========================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db
*.lnk

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Trae IDE 本地配置（不进入版本控制）
.trae/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
.venv/
env/
.env/
ENV/

# 测试与覆盖率
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# 类型检查与 lint 缓存
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Node.js ----------
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# 构建产物
dist/
dist-ssr/
build/
*.local

# 前端测试与缓存
coverage/
.nyc_output/
.vitest-cache/
.eslintcache
.stylelintcache

# Vite / Turbopack
.vite/
.turbo/

# ---------- 环境变量与密钥 ----------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
secrets.json
credentials.json

# LLM provider 配置（api_key 由管理后台落盘，不入版本控制；模板保留）
backend/configs/llm_providers.yaml
!backend/configs/llm_providers.yaml.example

# ---------- 数据库 ----------
*.sqlite3
*.sqlite3-journal
*.db
pgdata/
neo4j/data/
redis/data/

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 项目特定：数据采集与运行产物 ----------
# 原始爬虫数据（不入库，避免仓库膨胀）
backend/data/raw/
backend/data/interim/
backend/data/processed/
!backend/data/processed/.gitkeep

# 简历上传文件
uploads/
!uploads/.gitkeep

# Neo4j 数据快照与备份
backups/
dumps/
*.dump
*.cypher

# 模型权重与缓存
backend/models/
models/cache/
models/checkpoints/
*.bin
*.safetensors

# 运行产物（质量报告/评估报告等）
backend/reports/

# Airflow 运行时
airflow.db
airflow-webserver.pid
logs/airflow/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- 参考资料（本地保留，不入版本控制） ----------
reference/
